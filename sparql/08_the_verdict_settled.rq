# Beat 8: the verdict, settled. Each settled receipt advice paired with the original it settles: the two are records
# of the same receipt advice (the same Receipt Advice ID), the original generated by the receiving system with its
# pallets accepted with an exception, the settled one written after the issuer's Settlement Receipt permitted the
# transition OrderProblem to OrderProcessing. The settled record's PROV entity is the Receipt (urn:vsl:receipt:<id>),
# its activity label says what settled it, and the Receipt itself is held under settlement/ and verified on the
# Settlements page. The activity label tells the two records apart; every component bound.
PREFIX sdc4: <https://semanticdatacharter.com/ns/sdc4/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?receipt_id ?settlement_receipt ?settled_by (GROUP_CONCAT(DISTINCT ?condition; separator=", ") AS ?conditions_before) (GROUP_CONCAT(DISTINCT ?exception; separator=" | ") AS ?exceptions_before) ?inst ?inst_2 WHERE {
  ?a rdfs:label "Receipt Advice ID" ; sdc4:inInstance ?inst ; sdc4:inDataModel sdc4:dm-tog0v0p1zit1xwpxysxwpf3d ; rdf:reifies <<sdc4:mc-n8ktn56c09i6kzy6kxzqs53j ?p1 ?receipt_id>> .
  ?l rdfs:label "Activity Label" ; sdc4:inInstance ?inst ; rdf:reifies <<sdc4:mc-r6hkunjm2q0hlxiknlc9ljix ?p2 ?settled_by>> .
  FILTER(STRSTARTS(STR(?settled_by), "Settled"))
  ?e rdfs:label "Entity Identifier" ; sdc4:inInstance ?inst ; rdf:reifies <<sdc4:mc-i1defiugxfdcwfb9rqv4p5tz ?p3 ?settlement_receipt>> .
  ?b rdfs:label "Receipt Advice ID" ; sdc4:inInstance ?inst_2 ; sdc4:inDataModel sdc4:dm-tog0v0p1zit1xwpxysxwpf3d ; rdf:reifies <<sdc4:mc-n8ktn56c09i6kzy6kxzqs53j ?p4 ?receipt_id>> .
  ?lb rdfs:label "Activity Label" ; sdc4:inInstance ?inst_2 ; rdf:reifies <<sdc4:mc-r6hkunjm2q0hlxiknlc9ljix ?p5 ?generated_by>> .
  FILTER(STRSTARTS(STR(?generated_by), "Generated"))
  ?s rdfs:label "Receiving Condition" ; sdc4:inInstance ?inst_2 ; rdf:reifies <<sdc4:mc-xpl4g1gsbbgsqq3okyp08qb3 ?p6 ?condition>> .
  OPTIONAL { ?x rdfs:label "Exception Description" ; sdc4:inInstance ?inst_2 ; rdf:reifies <<sdc4:mc-civdvmt96axod0ho162jf37u ?p7 ?exception>> . }
}
GROUP BY ?receipt_id ?settlement_receipt ?settled_by ?inst ?inst_2
ORDER BY ?receipt_id
LIMIT 200
