sdc4:mc-q964qt4j2dtjvo06eea70en7 a sdc4-meta:ModelComponent ;
    rdfs:label "Remittance Advice Line" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-qb90a0sp9vvb6c5cbcf236ys a sdc4-meta:ModelComponent ;
