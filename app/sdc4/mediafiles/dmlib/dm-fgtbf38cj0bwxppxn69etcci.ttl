    rdfs:seeAlso <http://www.w3.org/2005/07/scxml> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType> .

sdc4:mc-xkkk5vyegpy4xdig8vnabstc a sdc4-meta:ModelComponent ;
    rdfs:label "Seller Supplier Party" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-xlgjqdpwdbn2re3mdh5yy2rk a sdc4-meta:ModelComponent ;
    rdfs:label "Error Message" ;
    rdfs:comment "The error the activity reported, if it failed." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-xr701u7jj2okhapf8bazq3i6 a sdc4-meta:ModelComponent ;
    rdfs:label "Order: orderproblem orderprocessing" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-xu9shazwk3k2lysypuqpam9c a sdc4-meta:ModelComponent ;
    rdfs:label "Remittance Advice Line 5" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-xvv7o2f1hcgq54tmodaj5969 a sdc4-meta:ModelComponent ;
    rdfs:label "Payment Purpose" ;
    rdfs:comment "The business purpose of the payment, as the parties agreed to state it: UBL carries no default list." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-REMITTANCE-ADVICE-LINE> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-xxe21o9ojzmy9wxxky1tnmog a sdc4-meta:ModelComponent ;
    rdfs:label "Agent Name" ;
    rdfs:comment "The name of the agent (foaf:name)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-xywkj11p7u8jhjaiim3h3gyp a sdc4-meta:ModelComponent ;
    rdfs:label "Document Currency" ;
    rdfs:comment "The ISO 4217 code of the default currency of the document; every amount carries its currency as its unit as well." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-ORDER> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-yandfsildrgawqjm1npmemmx a sdc4-meta:ModelComponent ;
    rdfs:label "Order: orderdelivered orderreturned" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-yat9nppabvpq1jrgpsi5g226 a sdc4-meta:ModelComponent ;
    rdfs:label "Tax Total" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-ybdlctks32zkkteycr5y1eq8 a sdc4-meta:ModelComponent ;
    rdfs:label "Customer Assigned Account ID" ;
    rdfs:comment "The identifier of the customer's account as the customer itself assigned it; on a supplier party, the identifier of the supplier as the customer assigned it." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-CUSTOMER-PARTY> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-yk5nrxndulhebpi3hiywk8u8 a sdc4-meta:ModelComponent ;
    rdfs:label "Generated At" ;
    rdfs:comment "When the entity was generated (prov:generatedAtTime)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTemporalType> .

sdc4:mc-yqcnjxce4q5k7w2os0ihi4cd a sdc4-meta:ModelComponent ;
    rdfs:label "Order: orderprocessing orderproblem" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-yzc81fh1c7y80msj8fqm5tgn a sdc4-meta:ModelComponent ;
    rdfs:label "Payment Order Reference" ;
    rdfs:comment "The payer's reference to its order for payment to its bank." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-REMITTANCE-ADVICE> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-z0gdpy67iot29gdc2zq2v1jj a sdc4-meta:ModelComponent ;
    rdfs:label "Party Identification" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-z181ta9jftxc7k63rv4nz1zv a sdc4-meta:ModelComponent ;
    rdfs:label "Document Description" ;
    rdfs:comment "Free text describing the referenced document for a reader." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-DOCUMENT-REFERENCE> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-zfqyw3u5kz7yxk8qgofj0dxj a sdc4-meta:ModelComponent ;
    rdfs:label "Line Document Reference" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-ziv6gmpthgks5vkfsyx2ib4t a sdc4-meta:ModelComponent ;
    rdfs:label "Additional Document Reference" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-znjvyfaljuuhab4hje617fyh a sdc4-meta:ModelComponent ;
    rdfs:label "Credit Note Document Reference" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#ClusterType> .

sdc4:mc-zpfwg52r88j6jdypj7rg71ke a sdc4-meta:ModelComponent ;
    rdfs:label "Phone Number" ;
    rdfs:comment "A telephone number, optionally starting with a plus sign and country code, with digits, spaces, hyphens and parentheses allowed." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-zvkk8ztob9gmrvvkzyibyrzk a sdc4-meta:ModelComponent ;
    rdfs:label "Note" ;
    rdfs:comment "Free text: a comment, remark or note attached to a record, up to 4000 characters." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-bvz91uwa2c28sr0k5u85zx04 a sdc4-meta:ModelComponent ;
    rdfs:label "Percentage" ;
    rdfs:comment "Parts per hundred." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-c3ycqqk7ns1bvmsc0ricnsbn a sdc4-meta:ModelComponent ;
    rdfs:label "Items" ;
    rdfs:comment "A count of discrete things, with no dimension." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-i16vqj89it3db7d3c5qjko9p a sdc4-meta:ModelComponent ;
    rdfs:label "PROV Agent Type" ;
    rdfs:comment "The kind of PROV agent: person, organization or software agent." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-mnuyvuxqsy0qskx8hiy6epff a sdc4-meta:ModelComponent ;
    rdfs:label "Document Status" ;
    rdfs:comment "The status of the document with respect to its original state: the original, a revision of it, or its cancellation. UBL leaves the status code to profiles; these are this library's values." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-DESPATCH-ADVICE> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-g2xnh3uhnlrnqlo7ki2s0fs3 a sdc4-meta:ModelComponent ;
    rdfs:label "PROV Derivation Type" ;
    rdfs:comment "How one entity was derived from another: a general derivation, a revision, a quotation or a primary source." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-rpz1czz06jhpahmfz30rblvp a sdc4-meta:ModelComponent ;
    rdfs:label "Audit Event Outcome" ;
    rdfs:comment "The result of an audited event (FHIR AuditEvent.outcome)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-b25dj42zxhm19pih328ga8pl a sdc4-meta:ModelComponent ;
    rdfs:label "Address Use" ;
    rdfs:comment "The purpose of an address." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-ce1c8sydkov8bkv4dgdmwe5x a sdc4-meta:ModelComponent ;
    rdfs:label "Audit Event Action" ;
    rdfs:comment "The operation performed in a logged access event (FHIR AuditEvent.action). Read and Execute change no state and are audit facts, not workflow moves." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-i4e2nod7ss9d4cumhn2pah8b a sdc4-meta:ModelComponent ;
    rdfs:label "PROV Entity Type" ;
    rdfs:comment "The kind of PROV entity: a plain entity, a collection, an empty collection, a bundle or a plan." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-vmruk4j9y1orvvz8cwafrax5 a sdc4-meta:ModelComponent ;
    rdfs:label "Contact Use" ;
    rdfs:comment "The purpose of a contact point." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-vbctgmdcwps5b3r3l6sboa6y a sdc4-meta:ModelComponent ;
    rdfs:label "Confidentiality" ;
    rdfs:comment "The level of protection the information requires (HL7 v3 Confidentiality). At assembly the value populates a component's act tag." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-wl6j4ekcmu4hvt2m12zw4zp8 a sdc4-meta:ModelComponent ;
    rdfs:label "Activity Status" ;
    rdfs:comment "The state of an activity, from the Data Privacy Vocabulary activity status concepts." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-c9v9nkkg6b8sixoaf55vyjrn a sdc4-meta:ModelComponent ;
    rdfs:label "Party Identification Scheme" ;
    rdfs:comment "The identification system a party's identifier belongs to: a GS1 Global Location Number, a DUNS number, a tax identifier, a company registration number, an identifier the buyer assigned, an identifier the seller assigned, or one the parties agreed between themselves. A GLN is GS1's and a buyer-assigned number is the buyer's; the record says which." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-PARTY-IDENTIFICATION> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-miqo30r5b554nyj7ubryw43x a sdc4-meta:ModelComponent ;
    rdfs:label "Contact Method" ;
    rdfs:comment "The communication channel of a contact point." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-d1evlz8yvdlwt6ia9fjq4pgj a sdc4-meta:ModelComponent ;
    rdfs:label "Purpose of Use" ;
    rdfs:comment "Why the information was used (HL7 v3 ActReason purpose of use). Activity context, not an access-control tag." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-ia7qf3je696yjjgzz4l5q0sp a sdc4-meta:ModelComponent ;
    rdfs:label "Document Type" ;
    rdfs:comment "What kind of document is referenced: a quotation, a contract, a catalogue, the originator's document, an earlier order, an order response, a despatch advice, a receipt advice, an invoice, a credit note, a remittance advice, or another document. Revised at the ReceiptAdvice release to name the documents of the chain and at the RemittanceAdvice release to name the billing documents; the published models keep composing the list each was published with." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-DOCUMENT-REFERENCE> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-jujsdur1igws8orw6tvvlqco a sdc4-meta:ModelComponent ;
    rdfs:label "Provenance Agent Type" ;
    rdfs:comment "The functional role of an agent in an activity (FHIR Provenance.agent.type)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-k9tqm489kilg33mx4cibyto6 a sdc4-meta:ModelComponent ;
    rdfs:label "US State Code" ;
    rdfs:comment "The two-letter USPS abbreviation of a US state, the District of Columbia or a US territory. The definition of each value is its ISO 3166-2:US entry." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-pv15bnowaxjtczx4wx4vit4d a sdc4-meta:ModelComponent ;
    rdfs:label "Payment Means" ;
    rdfs:comment "The means of payment agreed for the order, from the UN/ECE payment means list UBL carries as its default: the name of each means, defined by the list entry." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-PAYMENT-MEANS> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-hjjou19np3pohe63fxmqtkoi a sdc4-meta:ModelComponent ;
    rdfs:label "Currency" ;
    rdfs:comment "The ISO 4217 code of a currency: the complete list of 178 active codes. Each value is defined by its Wikidata entity." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-f2jicaigehz7xmwcp1gm5gh0 a sdc4-meta:ModelComponent ;
    rdfs:label "Country Code ISO 3166" ;
    rdfs:comment "The ISO 3166-1 alpha-2 code of a country or territory: the complete list of 249 officially assigned codes. Each value is defined by its Wikidata entity." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

