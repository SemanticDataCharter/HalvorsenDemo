            sh:path sdc4:hasCluster ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-ali2fmphdiyr4rsjmwhma86i .

sdc4:mc-q6n61ognf4b5e9dur9r6o26y-shape a sh:NodeShape ;
    rdfs:label "Business Document Translator Identifier" ;
    rdfs:comment "The identifier of the translator or application that produced the record from a document received, or wrote a document from it (PROV agent identifier; the audit's system id)." ;
