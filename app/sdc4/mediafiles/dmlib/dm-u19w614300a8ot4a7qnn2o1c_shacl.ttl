sdc4:mc-a3o0vyby3nousr4jhtlsddn9-shape a sh:NodeShape ;
    rdfs:label "Pricing Currency" ;
    rdfs:comment "The ISO 4217 code of the currency the prices in the order are stated in, when it differs from the document currency." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue <https://www.iso.org/iso-4217-currency-codes.html> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-ORDER> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://axius-sdc.com/library/business/pricing-currency> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html> ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "[A-Z]{3}" ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-a3o0vyby3nousr4jhtlsddn9 ;
    sdc4-meta:sdcType "XdStringType" .

