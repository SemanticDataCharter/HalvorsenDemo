  <rdf:Description rdf:about="https://semanticdatacharter.com/ns/sdc4/mc-q9k20amngqerxvhpvhwn9t3q">
    <rdf:type rdf:resource="https://semanticdatacharter.com/ontology/sdc4-meta/ModelComponent"/>
    <sdc4-meta:isConstrainedByRmComponent rdf:resource="https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType"/>
    <rdfs:label>Order Type</rdfs:label>
    <rdfs:comment>What kind of order this is. UBL leaves the code list to the parties; this library carries the kinds a supply chain uses: a standard order, a blanket order whose quantities are firm, a call-off against a blanket order, a consignment order, a drop-shipment order delivered to the buyer's customer, and a repeat order.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-ORDER"/>
  </rdf:Description>
