  <rdf:Description rdf:about="https://semanticdatacharter.com/ns/sdc4/mc-r3ptl4b9w3uoeryziruyyr0g">
    <rdf:type rdf:resource="https://semanticdatacharter.com/ontology/sdc4-meta/ModelComponent"/>
    <sdc4-meta:isConstrainedByRmComponent rdf:resource="https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdOrdinalType"/>
    <rdfs:label>Order: Main path states</rdfs:label>
    <rdfs:comment>States of the Main path path of the Order workflow, in order: OrderPaymentDue, OrderProcessing, OrderInTransit, OrderDelivered. A transition is legal between adjacent states. An order's status per schema.org OrderStatus: payment due, processing, in transit, delivered, with pickup, problem, cancellation and return.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2005/07/scxml"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://semanticdatacharter.com/ns/sdc4/mc-hjjou19np3pohe63fxmqtkoi/xdstring-value/TJS">
