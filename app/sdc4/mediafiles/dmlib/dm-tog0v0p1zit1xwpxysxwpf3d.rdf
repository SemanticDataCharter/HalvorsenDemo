  <rdf:Description rdf:about="https://semanticdatacharter.com/ns/sdc4/mc-c9v9nkkg6b8sixoaf55vyjrn">
    <rdf:type rdf:resource="https://semanticdatacharter.com/ontology/sdc4-meta/ModelComponent"/>
