    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-b25dj42zxhm19pih328ga8pl a sdc4-meta:ModelComponent ;
    rdfs:label "Address Use" ;
    rdfs:comment "The purpose of an address." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-ce1c8sydkov8bkv4dgdmwe5x a sdc4-meta:ModelComponent ;
    rdfs:label "Audit Event Action" ;
    rdfs:comment "The operation performed in a logged access event (FHIR AuditEvent.action). Read and Execute change no state and are audit facts, not workflow moves." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-i4e2nod7ss9d4cumhn2pah8b a sdc4-meta:ModelComponent ;
    rdfs:label "PROV Entity Type" ;
    rdfs:comment "The kind of PROV entity: a plain entity, a collection, an empty collection, a bundle or a plan." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-k04gbu3btfvb93r7cdp8hpj0 a sdc4-meta:ModelComponent ;
    rdfs:label "Transport Handling Unit Type" ;
    rdfs:comment "What kind of unit this is: a pallet, a case, a crate, a roll cage, or a container, as the UN/ECE Recommendation 21 packaging codes name them." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-TRANSPORT-HANDLING-UNIT> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-lnp7izhoh1fxop40bhzwancq a sdc4-meta:ModelComponent ;
    rdfs:label "Volume/Liquid Capacity (SI - Metric)" ;
    rdfs:comment "Metric units of liquid volume: millilitre, litre." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-sb5gat3jakjg1j6m78nq79in a sdc4-meta:ModelComponent ;
    rdfs:label "Line Status" ;
    rdfs:comment "The status of the line with respect to its original state: added, revised, cancelled, disputed, or no change of status." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-LINE-ITEM> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-vmruk4j9y1orvvz8cwafrax5 a sdc4-meta:ModelComponent ;
    rdfs:label "Contact Use" ;
    rdfs:comment "The purpose of a contact point." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-g7gz7adgd2fh6egkt84jnx7m a sdc4-meta:ModelComponent ;
    rdfs:label "Length/Distance (SI - Metric)" ;
    rdfs:comment "SI units of length: millimetre, centimetre, metre, kilometre." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-hyw1higymybzar9tv2ze77xa a sdc4-meta:ModelComponent ;
    rdfs:label "Document Type" ;
    rdfs:comment "What kind of document is referenced: a quotation, a contract, a catalogue, the originator's document, an earlier order, or another document." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-DOCUMENT-REFERENCE> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-k84kh4trdynaoi242c268lat a sdc4-meta:ModelComponent ;
    rdfs:label "Item Identification Scheme" ;
    rdfs:comment "The identification system an item identifier belongs to: a GS1 Global Trade Item Number, the buyer's item number, the seller's item number, the manufacturer's item number, a catalogue item number, or a system the parties agreed between themselves. A GTIN is GS1's and a buyer's item number is the buyer's; the record says which." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-ITEM-IDENTIFICATION> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-n7s7hcgef4pxius8a0l6r5qp a sdc4-meta:ModelComponent ;
    rdfs:label "Mass/Weight (SI - Metric)" ;
    rdfs:comment "SI units of mass: milligram, gram, kilogram." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-q9k20amngqerxvhpvhwn9t3q a sdc4-meta:ModelComponent ;
    rdfs:label "Order Type" ;
    rdfs:comment "What kind of order this is. UBL leaves the code list to the parties; this library carries the kinds a supply chain uses: a standard order, a blanket order whose quantities are firm, a call-off against a blanket order, a consignment order, a drop-shipment order delivered to the buyer's customer, and a repeat order." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-ORDER> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-vbctgmdcwps5b3r3l6sboa6y a sdc4-meta:ModelComponent ;
    rdfs:label "Confidentiality" ;
    rdfs:comment "The level of protection the information requires (HL7 v3 Confidentiality). At assembly the value populates a component's act tag." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-wl6j4ekcmu4hvt2m12zw4zp8 a sdc4-meta:ModelComponent ;
    rdfs:label "Activity Status" ;
    rdfs:comment "The state of an activity, from the Data Privacy Vocabulary activity status concepts." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-z89am2q73qovwbnctjmztg8x a sdc4-meta:ModelComponent ;
    rdfs:label "Packaging Type" ;
    rdfs:comment "What kind of package the item is packed in: a case, a carton, a bag, a tray, a drum, or a bale, as the UN/ECE Recommendation 21 packaging codes name them." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-PACKAGE> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-c9v9nkkg6b8sixoaf55vyjrn a sdc4-meta:ModelComponent ;
    rdfs:label "Party Identification Scheme" ;
    rdfs:comment "The identification system a party's identifier belongs to: a GS1 Global Location Number, a DUNS number, a tax identifier, a company registration number, an identifier the buyer assigned, an identifier the seller assigned, or one the parties agreed between themselves. A GLN is GS1's and a buyer-assigned number is the buyer's; the record says which." ;
    rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-PARTY-IDENTIFICATION> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-miqo30r5b554nyj7ubryw43x a sdc4-meta:ModelComponent ;
    rdfs:label "Contact Method" ;
    rdfs:comment "The communication channel of a contact point." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-c3ycqqk7ns1bvmsc0ricnsbn a sdc4-meta:ModelComponent ;
    rdfs:label "Items" ;
    rdfs:comment "A count of discrete things, with no dimension." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-d1evlz8yvdlwt6ia9fjq4pgj a sdc4-meta:ModelComponent ;
    rdfs:label "Purpose of Use" ;
    rdfs:comment "Why the information was used (HL7 v3 ActReason purpose of use). Activity context, not an access-control tag." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-jujsdur1igws8orw6tvvlqco a sdc4-meta:ModelComponent ;
    rdfs:label "Provenance Agent Type" ;
    rdfs:comment "The functional role of an agent in an activity (FHIR Provenance.agent.type)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-ntkkz1y6mcw04pswtx7ghkn4 a sdc4-meta:ModelComponent ;
    rdfs:label "Trade Units" ;
    rdfs:comment "The units a business document line is ordered, priced, delivered or packed in: the UN/ECE Recommendation 20 codes for discrete packaging (each, case, pack, pallet, box, carton, dozen) and the dimensional units in common use, each defined by the Recommendation 20 entry or the QUDT unit it means. The complete list of 1,732 codes is domain content and stays in data/codes." ;
    rdfs:seeAlso <https://unece.org/trade/uncefact/cl-recommendations> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-k9tqm489kilg33mx4cibyto6 a sdc4-meta:ModelComponent ;
    rdfs:label "US State Code" ;
    rdfs:comment "The two-letter USPS abbreviation of a US state, the District of Columbia or a US territory. The definition of each value is its ISO 3166-2:US entry." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-f2jicaigehz7xmwcp1gm5gh0 a sdc4-meta:ModelComponent ;
    rdfs:label "Country Code ISO 3166" ;
    rdfs:comment "The ISO 3166-1 alpha-2 code of a country or territory: the complete list of 249 officially assigned codes. Each value is defined by its Wikidata entity." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

