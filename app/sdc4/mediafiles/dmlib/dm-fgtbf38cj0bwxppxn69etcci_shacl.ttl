sdc4:mc-c9v9nkkg6b8sixoaf55vyjrn-shape a sh:NodeShape ;
    rdfs:label "Party Identification Scheme" ;
    rdfs:comment "The identification system a party's identifier belongs to: a GS1 Global Location Number, a DUNS number, a tax identifier, a company registration number, an identifier the buyer assigned, an identifier the seller assigned, or one the parties agreed between themselves. A GLN is GS1's and a buyer-assigned number is the buyer's; the record says which." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:hasValue <https://axius-sdc.com/library/business/party-identification-scheme> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:token ;
            sh:in ( "Global Location Number (GS1)" "DUNS number" "Tax identifier" "Company registration number" "Assigned by the buyer" "Assigned by the seller" "Mutually agreed" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html#T-PARTY-IDENTIFICATION> ;
            sh:path rdfs:seeAlso ] ;
    sh:targetNode sdc4:mc-c9v9nkkg6b8sixoaf55vyjrn ;
    sdc4-meta:sdcType "XdTokenType" .

