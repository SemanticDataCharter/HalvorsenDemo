sdc4:mc-r3ptl4b9w3uoeryziruyyr0g-shape a sh:NodeShape ;
    rdfs:label "Order: Main path states" ;
    rdfs:comment "States of the Main path path of the Order workflow, in order: OrderPaymentDue, OrderProcessing, OrderInTransit, OrderDelivered. A transition is legal between adjacent states. An order's status per schema.org OrderStatus: payment due, processing, in transit, delivered, with pickup, problem, cancellation and return." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:hasValue schema: ;
            sh:path dcterms:source ],
        [ sh:hasValue schema:OrderStatus ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/order-main-states> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:in ( "OrderPaymentDue" "OrderProcessing" "OrderInTransit" "OrderDelivered" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" "2" "3" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ] ;
    sh:targetNode sdc4:mc-r3ptl4b9w3uoeryziruyyr0g ;
    sdc4-meta:sdcType "XdOrdinalType" .

