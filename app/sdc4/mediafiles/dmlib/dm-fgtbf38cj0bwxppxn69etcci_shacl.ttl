sdc4:mc-wchjtpjshozfm3pwzpp4lu5s-shape a sh:NodeShape ;
    rdfs:label "Order: orderproblem orderprocessing states" ;
    rdfs:comment "States of the orderproblem orderprocessing path of the Order workflow, in order: OrderProblem, OrderProcessing. A transition is legal between adjacent states. An order's status per schema.org OrderStatus: payment due, processing, in transit, delivered, with pickup, problem, cancellation and return." ;
    sh:node sdc4:XdOrdinalBaseShape ;
    sh:property [ sh:hasValue schema: ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/order-orderproblem-orderprocessing-states> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <http://www.w3.org/2005/07/scxml> ;
            sh:path rdfs:seeAlso ],
        [ sh:datatype xsd:string ;
            sh:in ( "OrderProblem" "OrderProcessing" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:symbol ],
        [ sh:hasValue schema:OrderStatus ;
            sh:path skos:exactMatch ],
        [ sh:datatype xsd:decimal ;
            sh:in ( "0" "1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:ordinal ] ;
    sh:targetNode sdc4:mc-wchjtpjshozfm3pwzpp4lu5s ;
    sdc4-meta:sdcType "XdOrdinalType" .

